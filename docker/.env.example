# Database
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=quran_academy
POSTGRES_USER=quran_admin
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIOコンソール_URL=http://localhost:9001

# Jitsi
JITSI_PUBLIC_URL=https://meet.quran-academy.com
JITSI_JVB_AUTH_PASSWORD=your_secure_jvb_password_here

# JWT Auth
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Magic Link
MAGIC_LINK_SECRET=your_secure_magic_link_secret_here

# Application
APP_URL=https://quran-academy.com
APP_PORT=3000
NODE_ENV=production

# Backend (NestJS)
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Uptime Kuma
UPTIME_KUMA_PORT=3001
